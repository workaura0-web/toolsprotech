# ToolsProTech Environment Configuration Template
# Copy to .env.local for local development or configure in your deployment platform

# Google Gemini API Key for Server-Side AI Article Rewriting and Paraphrasing
# Format: AIzaSy...
GEMINI_API_KEY=

# OpenPageRank API Key for Domain Authority and Page Authority Registry
# https://openpagerank.com
OPENPAGERANK_API_KEY=

# WhoisXmlApi API Key for Domain Age and Registry Lookup
# https://whois.whoisxmlapi.com
WHOISXMLAPI_KEY=

# IP Geolocation API Key for IP Lookups
# https://ipapi.com
IPAPI_KEY=

# HubSpot Form & Portal IDs for Hiring and Contact forms
HUBSPOT_FORM_GUID=
HUBSPOT_PORTAL_ID=